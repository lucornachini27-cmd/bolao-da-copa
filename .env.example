# Copie para .env e ajuste os valores. NUNCA versione o .env real.

APP_NAME=Bolão da Copa

# MVP em SQLite (arquivo local). Em produção troque pela URL do PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:senha@localhost:5432/bolao
DATABASE_URL=sqlite:///./bolao.db

# --- football-data.org ---
FOOTBALL_DATA_TOKEN=coloque_seu_token_aqui
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
COMPETITION_CODE=WC

# --- Auth (JWT) ---
# Gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque_isto_por_uma_chave_aleatoria_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Localização ---
LOCAL_TIMEZONE=America/Sao_Paulo
